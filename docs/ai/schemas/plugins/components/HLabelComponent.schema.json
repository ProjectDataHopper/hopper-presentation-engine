{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "title" : "HLabelComponent",
  "type" : "object",
  "description" : "A Label to decorate your presentations",
  "properties" : {
    "pluginId" : {
      "type" : "string",
      "description" : "Must equal HLabelComponent"
    },
    "label" : {
      "type" : "string",
      "title" : "Label text",
      "description" : "The label text (variables are resolved at render time)"
    },
    "underline" : {
      "type" : "boolean",
      "title" : "Underline?",
      "description" : ""
    },
    "horizontalAlignment" : {
      "type" : "string",
      "enum" : [ "LEFT", "RIGHT", "CENTER" ],
      "title" : "Horizontal alignment",
      "description" : ""
    },
    "verticalAlignment" : {
      "type" : "string",
      "enum" : [ "TOP", "BOTTOM", "MIDDLE" ],
      "title" : "Vertical alignment",
      "description" : ""
    },
    "themeName" : {
      "type" : "string",
      "title" : "Theme name",
      "description" : ""
    },
    "borderColor" : {
      "type" : "string",
      "title" : "Border color",
      "description" : ""
    },
    "backGroundColor" : {
      "type" : "string",
      "title" : "Background color",
      "description" : ""
    },
    "defaultFont" : {
      "type" : "string",
      "title" : "Default font",
      "description" : ""
    },
    "defaultColor" : {
      "type" : "string",
      "title" : "Default color",
      "description" : ""
    },
    "rotation" : {
      "type" : "string",
      "title" : "Rotation (degrees)",
      "description" : "Rotation angle in degrees around the component center"
    },
    "transparency" : {
      "type" : "string",
      "title" : "Transparency (0-100)",
      "description" : "Opacity as a percentage: 0 = invisible, 100 = fully opaque"
    },
    "clipSize" : {
      "type" : "string",
      "title" : "Clip size",
      "description" : "When width and height are set (>0), drawing is clipped to the component geometry"
    },
    "left" : {
      "type" : "string",
      "title" : "Left alignment"
    },
    "right" : {
      "type" : "string",
      "title" : "Right alignment"
    },
    "top" : {
      "type" : "string",
      "title" : "Top alignment"
    },
    "bottom" : {
      "type" : "string",
      "title" : "Bottom alignment"
    }
  }
}