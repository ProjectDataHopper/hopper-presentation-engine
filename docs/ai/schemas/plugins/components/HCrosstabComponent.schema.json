{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "title" : "HCrosstabComponent",
  "type" : "object",
  "description" : "A crosstab component",
  "properties" : {
    "pluginId" : {
      "type" : "string",
      "description" : "Must equal HCrosstabComponent"
    },
    "sourceConnectorName" : {
      "type" : "string",
      "title" : "Input connector",
      "description" : "Optional data connector feeding this component"
    },
    "horizontalDimensions" : {
      "type" : "array",
      "title" : "Horizontal dimensions",
      "description" : ""
    },
    "swapHorizontalVerticalDimensions" : {
      "type" : "string",
      "title" : "Swap horizontal and vertical columns",
      "description" : "Exchange the horizontal and vertical dimension lists (transpose the crosstab axes)"
    },
    "verticalDimensions" : {
      "type" : "array",
      "title" : "Vertical dimensions",
      "description" : ""
    },
    "facts" : {
      "type" : "array",
      "title" : "Facts",
      "description" : ""
    },
    "showingHorizontalTotals" : {
      "type" : "boolean",
      "title" : "Show horizontal totals?",
      "description" : ""
    },
    "showingVerticalTotals" : {
      "type" : "boolean",
      "title" : "Show vertical totals?",
      "description" : ""
    },
    "horizontalDimensionsFont" : {
      "type" : "string",
      "title" : "Horizontal dimensions font",
      "description" : ""
    },
    "horizontalDimensionsColor" : {
      "type" : "string",
      "title" : "Horizontal dimensions color",
      "description" : ""
    },
    "verticalDimensionsFont" : {
      "type" : "string",
      "title" : "Vertical dimensions font",
      "description" : ""
    },
    "verticalDimensionsColor" : {
      "type" : "string",
      "title" : "Vertical dimensions color",
      "description" : ""
    },
    "factsFont" : {
      "type" : "string",
      "title" : "Facts font",
      "description" : ""
    },
    "factsColor" : {
      "type" : "string",
      "title" : "Facts color",
      "description" : ""
    },
    "titleFont" : {
      "type" : "string",
      "title" : "Title font",
      "description" : ""
    },
    "titleColor" : {
      "type" : "string",
      "title" : "Title color",
      "description" : ""
    },
    "gridColor" : {
      "type" : "string",
      "title" : "Grid color",
      "description" : ""
    },
    "axisColor" : {
      "type" : "string",
      "title" : "Axis color",
      "description" : ""
    },
    "horizontalMargin" : {
      "type" : "string",
      "title" : "Horizontal margin",
      "description" : ""
    },
    "verticalMargin" : {
      "type" : "string",
      "title" : "Vertical margin",
      "description" : ""
    },
    "evenHeights" : {
      "type" : "boolean",
      "title" : "Even heights?",
      "description" : ""
    },
    "headerOnEveryPage" : {
      "type" : "boolean",
      "title" : "Header on every page?",
      "description" : ""
    },
    "showingHorizontalSubtotals" : {
      "type" : "boolean",
      "title" : "Show horizontal subtotals?",
      "description" : ""
    },
    "showingVerticalSubtotals" : {
      "type" : "boolean",
      "title" : "Show vertical subtotals?",
      "description" : ""
    },
    "themeName" : {
      "type" : "string",
      "title" : "Theme name",
      "description" : ""
    },
    "borderColor" : {
      "type" : "string",
      "title" : "Border color",
      "description" : ""
    },
    "backGroundColor" : {
      "type" : "string",
      "title" : "Background color",
      "description" : ""
    },
    "defaultFont" : {
      "type" : "string",
      "title" : "Default font",
      "description" : ""
    },
    "defaultColor" : {
      "type" : "string",
      "title" : "Default color",
      "description" : ""
    },
    "rotation" : {
      "type" : "string",
      "title" : "Rotation (degrees)",
      "description" : "Rotation angle in degrees around the component center"
    },
    "transparency" : {
      "type" : "string",
      "title" : "Transparency (0-100)",
      "description" : "Opacity as a percentage: 0 = invisible, 100 = fully opaque"
    },
    "clipSize" : {
      "type" : "string",
      "title" : "Clip size",
      "description" : "When width and height are set (>0), drawing is clipped to the component geometry"
    },
    "left" : {
      "type" : "string",
      "title" : "Left alignment"
    },
    "right" : {
      "type" : "string",
      "title" : "Right alignment"
    },
    "top" : {
      "type" : "string",
      "title" : "Top alignment"
    },
    "bottom" : {
      "type" : "string",
      "title" : "Bottom alignment"
    }
  }
}