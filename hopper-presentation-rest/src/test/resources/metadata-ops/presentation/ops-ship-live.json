{
  "name": "ops-ship-live",
  "description": "Live Ship runs via REST (${HOPPER_SHIP_API_URL}/api/runs). Requires Ship API reachable; uses caller Bearer when auth is on.",
  "defaultThemeName": "Default",
  "autoRefreshSeconds": 20,
  "virtualPath": "ops",
  "pages": [
    {
      "name": "Live runs",
      "components": [
        {
          "name": "title",
          "layout": {
            "top": { "offset": 12, "percentage": 0, "alignment": "TOP" },
            "left": { "offset": 12, "percentage": 0, "alignment": "LEFT" }
          },
          "component": {
            "HLabelComponent": {
              "pluginId": "HLabelComponent",
              "label": "Operations — live Ship runs",
              "themeName": "Default"
            }
          }
        },
        {
          "name": "live-table",
          "layout": {
            "top": { "offset": 48, "percentage": 0, "alignment": "TOP" },
            "left": { "offset": 12, "percentage": 0, "alignment": "LEFT" },
            "bottom": { "offset": 12, "percentage": 0, "alignment": "BOTTOM" },
            "right": { "offset": 12, "percentage": 0, "alignment": "RIGHT" }
          },
          "component": {
            "HTableComponent": {
              "pluginId": "HTableComponent",
              "sourceConnectorName": "ship-runs",
              "themeName": "Default",
              "header": true,
              "headerOnEveryPage": true,
              "evenHeights": true,
              "border": false,
              "horizontalMargin": 2,
              "verticalMargin": 2,
              "columnSelection": [
                { "columnName": "runId", "headerValue": "Run ID", "width": 120, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "webServiceName", "headerValue": "Service", "width": 160, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "workerHost", "headerValue": "Worker", "width": 140, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "status", "headerValue": "Status", "width": 90, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "startTime", "headerValue": "Started", "width": 180, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "endTime", "headerValue": "Ended", "width": 180, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "result", "headerValue": "Result", "width": 100, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" }
              ]
            }
          }
        }
      ]
    }
  ],
  "interactions": [],
  "parameterMappings": []
}
