{
  "name": "ops-failures",
  "description": "Failed Ship pipeline / web-service runs (sample offline; use ship-runs + filter for live).",
  "defaultThemeName": "Default",
  "autoRefreshSeconds": 60,
  "virtualPath": "ops",
  "pages": [
    {
      "name": "Failures",
      "components": [
        {
          "name": "title",
          "layout": {
            "top": { "offset": 12, "percentage": 0, "alignment": "TOP" },
            "left": { "offset": 12, "percentage": 0, "alignment": "LEFT" }
          },
          "component": {
            "HLabelComponent": {
              "pluginId": "HLabelComponent",
              "label": "Operations — failed runs",
              "themeName": "Default"
            }
          }
        },
        {
          "name": "failures-table",
          "layout": {
            "top": { "offset": 48, "percentage": 0, "alignment": "TOP" },
            "left": { "offset": 12, "percentage": 0, "alignment": "LEFT" },
            "bottom": { "offset": 12, "percentage": 0, "alignment": "BOTTOM" },
            "right": { "offset": 12, "percentage": 0, "alignment": "RIGHT" }
          },
          "component": {
            "HTableComponent": {
              "pluginId": "HTableComponent",
              "sourceConnectorName": "ops-failures",
              "themeName": "Default",
              "header": true,
              "headerOnEveryPage": true,
              "evenHeights": true,
              "border": false,
              "horizontalMargin": 2,
              "verticalMargin": 2,
              "columnSelection": [
                { "columnName": "runId", "headerValue": "Run ID", "width": 90, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "webServiceName", "headerValue": "Service", "width": 140, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "workerHost", "headerValue": "Worker", "width": 120, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "startTime", "headerValue": "Started", "width": 160, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "endTime", "headerValue": "Ended", "width": 160, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "result", "headerValue": "Result", "width": 80, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" },
                { "columnName": "logText", "headerValue": "Log", "width": 280, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE" }
              ]
            }
          }
        }
      ]
    }
  ],
  "interactions": [],
  "parameterMappings": []
}
